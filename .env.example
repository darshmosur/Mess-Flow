# ==============================================================================
# MessFlow Environment Variables for Local Development and Vercel Deployment
# ==============================================================================

# Supabase Public Configuration (Required for Vercel Production & Preview)
# Obtain these from: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional Server-Only Secret (Used only for administrative scripts / CLI seeding)
# DO NOT prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
